{
  "name": "@arte-modelo/api",
  "version": "2.0.0-alpha.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:sqlite:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:sqlite:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:test:push": "cross-env DATABASE_URL=file:./test.db prisma db push --schema=prisma/schema.sqlite.prisma --force-reset --accept-data-loss",
    "db:postgres:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:postgres:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:permissions": "tsx src/db/seed-permissions-cli.ts"
  },
  "dependencies": {
    "@arte-modelo/shared": "*",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.1.1",
    "cross-env": "^7.0.3",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
