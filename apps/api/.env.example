# ==============================================================================
# Arte Modelo Dubois 2.0 — Backend API Environment Variables
# ==============================================================================
# 4 Entornos estrictamente separados:
#   1. Local Dev:   DATABASE_URL="file:./dev.db" (SQLite local en esta PC)
#   2. Local Test:  TEST_DATABASE_URL="file:./test.db" (SQLite exclusivo de tests)
#   3. Staging:     Neon PostgreSQL (rama development — datos de demo/seed)
#   4. Producción:  Neon PostgreSQL (rama main — operación real, NO TOCAR en dev)
# ==============================================================================

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de datos Local Dev (SQLite):
DATABASE_URL="file:./dev.db"

# Base de datos Neon PostgreSQL (Staging o Producción — solo en nube):
# DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secretos JWT (generar valores aleatorios largos de 64+ chars en Staging y Prod):
JWT_ACCESS_SECRET="arte-modelo-dubois-local-access-secret-change-in-prod"
JWT_REFRESH_SECRET="arte-modelo-dubois-local-refresh-secret-change-in-prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Correo Transaccional (alineado con Kroma Lab Sales Studio: smtp | resend | mock)
# En local dev puedes usar "mock" para ver enlaces en consola sin enviar correos reales.
EMAIL_PROVIDER="mock"
EMAIL_FROM='"Arte Modelo Dubois" <no-reply@artemodelodubois.gt>'

# Opción A: SMTP (Gmail App Password / igual que Kroma Lab Sales Studio)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""

# Opción B: Resend API (alternativa transaccional moderna)
RESEND_API_KEY=""

# Almacenamiento de Imágenes / Comprobantes — Cloudflare R2 (igual que Kroma Lab Sales Studio)
# $0 Egress, 10 GB gratis. Si queda vacío en desarrollo, se usa almacenamiento local simulado.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="arte-modelo-dubois-assets"
R2_PUBLIC_URL=""

# Alternativa opcional: Cloudinary (si prefieres mantener tu cuenta de v1.0)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
