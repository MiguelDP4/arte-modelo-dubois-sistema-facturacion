generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String         @id @default(cuid())
  email                      String         @unique
  passwordHash               String?
  fullName                   String
  phone                      String?
  role                       String         @default("CUSTOMER") // ADMIN | EMPLOYEE | CUSTOMER
  isActive                   Boolean        @default(true)
  isVerified                 Boolean        @default(false)
  verificationTokenHash      String?        @unique
  verificationTokenExpiresAt DateTime?
  invitationTokenHash        String?        @unique
  invitationExpiresAt        DateTime?
  invitedById                String?
  invitedBy                  User?          @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers               User[]          @relation("UserInvitations")
  customerId                 String?
  customer                   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refreshTokens              RefreshToken[]
  stockMovements             StockMovement[] @relation("StockMovementActor")
  createdOrders              Order[]         @relation("OrderCreator")
  confirmedOrders            Order[]         @relation("OrderConfirmer")
  cancelledOrders            Order[]         @relation("OrderCanceller")
  dispatchEvents             DispatchEvent[] @relation("DispatchActor")
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([customerId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  module          String
  name            String
  description     String
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String // ADMIN | EMPLOYEE | CUSTOMER
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([role, permissionId])
  @@index([role])
}

model Product {
  id                String          @id @default(cuid())
  name              String
  description       String?
  priceGTQ          Float?
  priceHNL          Float?
  priceNIO          Float?
  priceUSD          Float?
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  isActive          Boolean         @default(true)
  deletedAt         DateTime?
  codes             ProductCode[]
  images            ProductImage[]
  stockMovements    StockMovement[]
  orderItems        OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([isActive, deletedAt])
}

model ProductCode {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String   @unique
  label     String   @default("Interno")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          String // INITIAL | MANUAL_IN | MANUAL_OUT | MANUAL_ADJUST | ORDER_PACK | ORDER_REVERT | CONSIGNMENT_RETURN
  quantityDelta Int
  previousStock Int
  newStock      Int
  reason        String
  reference     String?
  performedById String?
  performedBy   User?    @relation("StockMovementActor", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id          String    @id @default(cuid())
  companyName String
  managerName String
  phone       String
  email       String    @unique
  country     String    @default("GT")
  currency    String    @default("GTQ")
  address     String
  taxId       String
  notes       String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  users       User[]
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([country])
  @@index([isActive, deletedAt])
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type               String          @default("REGULAR") // REGULAR | CONSIGNMENT
  approvalStatus     String          @default("CONFIRMED") // PENDING_CONFIRMATION | CONFIRMED | CANCELLED
  fulfillmentStatus  String          @default("PENDING_PACKING") // PENDING_PACKING | PACKING | READY_TO_DISPATCH | PARTIALLY_DISPATCHED | COMPLETED
  paymentStatus      String          @default("PENDING_PAYMENT") // PENDING_PAYMENT | PARTIALLY_PAID | PAID
  currency           String          @default("GTQ")
  subtotal           Float           @default(0)
  itemsDiscountTotal Float           @default(0)
  shippingCost       Float           @default(0)
  shippingDiscount   Float           @default(0)
  totalAmount        Float           @default(0)
  amountPaid         Float           @default(0)
  amountPending      Float           @default(0)
  consignmentDueDate DateTime?
  notes              String?
  createdById        String?
  createdBy          User?           @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedById      String?
  confirmedBy        User?           @relation("OrderConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  cancelledById      String?
  cancelledBy        User?           @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancelReason       String?
  items              OrderItem[]
  dispatches         DispatchEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([customerId, createdAt])
  @@index([approvalStatus])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([type])
}

model OrderItem {
  id                 String              @id @default(cuid())
  orderId            String
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName        String
  productPrimaryCode String
  quantityOrdered    Int
  quantityPacked     Int                 @default(0)
  quantityDispatched Int                 @default(0)
  unitPrice          Float               @default(0)
  discountType       String              @default("FIXED") // FIXED | PERCENT
  discountValue      Float               @default(0)
  discountAmount     Float               @default(0)
  lineTotal          Float               @default(0)
  dispatchItems      DispatchEventItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

model DispatchEvent {
  id             String              @id @default(cuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchNumber Int
  dispatchedAt   DateTime            @default(now())
  carrier        String?
  notes          String?
  dispatchedById String?
  dispatchedBy   User?               @relation("DispatchActor", fields: [dispatchedById], references: [id], onDelete: SetNull)
  items          DispatchEventItem[]
  createdAt      DateTime            @default(now())

  @@unique([orderId, dispatchNumber])
  @@index([orderId, dispatchedAt])
}

model DispatchEventItem {
  id                   String        @id @default(cuid())
  dispatchEventId      String
  dispatchEvent        DispatchEvent @relation(fields: [dispatchEventId], references: [id], onDelete: Cascade)
  orderItemId          String
  orderItem            OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantityDispatched   Int
  cumulativeDispatched Int
  remainingPending     Int

  @@unique([dispatchEventId, orderItemId])
  @@index([orderItemId])
}
