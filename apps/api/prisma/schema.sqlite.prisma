generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String         @id @default(cuid())
  email                      String         @unique
  passwordHash               String?
  fullName                   String
  phone                      String?
  role                       String         @default("CUSTOMER") // ADMIN | EMPLOYEE | CUSTOMER
  isActive                   Boolean        @default(true)
  isVerified                 Boolean        @default(false)
  verificationTokenHash      String?        @unique
  verificationTokenExpiresAt DateTime?
  invitationTokenHash        String?        @unique
  invitationExpiresAt        DateTime?
  invitedById                String?
  invitedBy                  User?          @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers               User[]          @relation("UserInvitations")
  customerId                 String?
  customer                   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refreshTokens              RefreshToken[]
  stockMovements             StockMovement[] @relation("StockMovementActor")
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([customerId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  module          String
  name            String
  description     String
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String // ADMIN | EMPLOYEE | CUSTOMER
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([role, permissionId])
  @@index([role])
}

model Product {
  id                String          @id @default(cuid())
  name              String
  description       String?
  category          String?
  priceGTQ          Float?
  priceHNL          Float?
  priceNIO          Float?
  priceUSD          Float?
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  isActive          Boolean         @default(true)
  deletedAt         DateTime?
  codes             ProductCode[]
  images            ProductImage[]
  stockMovements    StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([isActive, deletedAt])
  @@index([category])
}

model ProductCode {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String   @unique
  label     String   @default("Interno")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          String // INITIAL | MANUAL_IN | MANUAL_OUT | MANUAL_ADJUST | ORDER_PACK | ORDER_REVERT | CONSIGNMENT_RETURN
  quantityDelta Int
  previousStock Int
  newStock      Int
  reason        String
  reference     String?
  performedById String?
  performedBy   User?    @relation("StockMovementActor", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id          String    @id @default(cuid())
  companyName String
  managerName String
  phone       String
  email       String    @unique
  country     String    @default("GT")
  currency    String    @default("GTQ")
  address     String
  taxId       String
  notes       String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([country])
  @@index([isActive, deletedAt])
}
